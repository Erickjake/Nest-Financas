# =============================
# App
# =============================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# =============================
# Database (PostgreSQL)
# =============================
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/financas

# =============================
# Auth (JWT)
# =============================
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================
# Observability - OpenTelemetry
# =============================
OTEL_SERVICE_NAME=financas-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# =============================
# Metrics
# If empty, /metrics is public.
# If set, send header: Authorization: Bearer <token>
# =============================
METRICS_AUTH_TOKEN=

# =============================
# Docker Compose (optional)
# =============================
# For local Alertmanager config:
# ALERTMANAGER_CONFIG_FILE=./observability/alertmanager/alertmanager.yml
# For production Alertmanager config:
# ALERTMANAGER_CONFIG_FILE=./observability/alertmanager/alertmanager.production.yml
