// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 1. Nossa nova tabela de Usuários
model User {
  id               Int       @id @default(autoincrement())
  name             String
  email            String    @unique // O @unique garante que ninguém use o mesmo email duas vezes
  password         String
  refreshTokenHash String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt // Atualizado automaticamente a cada mudança
  deletedAt        DateTime? // Para soft delete: null = ativo, datetime = deletado

  // Aqui dizemos que o usuário possui uma lista de transações (note os colchetes [])
  transactions Transaction[]
  budgets      Budget[]
  goals        Goal[]
}

// 2. Nossa tabela de Transações atualizada
// 2. Atualizar Transaction para incluir Category
model Transaction {
  id        Int       @id @default(autoincrement())
  title     String
  amount    Float
  type      String // "INCOME" | "EXPENSE" | "TRANSFER"
  date      DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  // Relação com usuário (mantém o mesmo)
  user   User @relation(fields: [userId], references: [id])
  userId Int

  // 🆕 Relação com categoria
  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId Int? // Opcional: nem toda transação precisa ter categoria

  @@index([userId])
  @@index([categoryId]) // 🆕 Índice para buscar por categoria
}

// 🏷️ Nova tabela de Categorias
model Category {
  id          Int       @id @default(autoincrement())
  name        String // "Alimentação", "Transporte", "Saúde", etc
  description String? // Opcional: "Gastos com comida"
  color       String? // Opcional: "#FF5733" para UI
  icon        String? // Opcional: "🍔" emoji
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime? // Soft delete

  // Relação: Uma categoria tem MUITAS transações
  transactions Transaction[]
  budgets      Budget[]

  // Índice composto: (name + id) para buscar rápido
  @@index([name])
}

// 💰 Tabela de Orçamentos Mensais
model Budget {
  id             Int       @id @default(autoincrement())
  amount         Float // Valor limite do orçamento
  month          Int // Mês (1-12)
  year           Int // Ano (ex: 2026)
  alertThreshold Float     @default(80) // Percentual para alerta (ex: 80 = alerta em 80%)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  deletedAt      DateTime?

  user   User @relation(fields: [userId], references: [id])
  userId Int

  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId Int?

  @@unique([userId, categoryId, month, year]) // Um orçamento por categoria/mês/ano/usuário
  @@index([userId])
  @@index([categoryId])
}

// 🎯 Tabela de Metas Financeiras
model Goal {
  id            Int       @id @default(autoincrement())
  title         String
  targetAmount  Float
  currentAmount Float     @default(0)
  dueDate       DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  deletedAt     DateTime?

  user   User @relation(fields: [userId], references: [id])
  userId Int

  @@index([userId])
  @@index([dueDate])
}
